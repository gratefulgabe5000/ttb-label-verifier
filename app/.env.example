# Database (SQLite — CR-003)
DATABASE_URL=sqlite:///./data/workingfiles.db

# Uploaded file storage (form PDFs + label images, A-16/SR-003)
UPLOAD_DIR=./data/uploads

# JWT auth (DevLog Decision 8 #15 — python-jose + passlib)
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# NOTE: ANTHROPIC_API_KEY is intentionally NOT configured here.
# Each agent provides their own Anthropic API key at runtime via the
# frontend Settings panel (gear icon). The key is held only in this
# server process's environment for the life of the process — it is
# never written to disk, to this file, or to the database.
